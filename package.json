{
  "name": "gentabase",
  "version": "0.0.0-automated",
  "description": "Gentabase CLI",
  "repository": "hk8xb/gentabase-cli",
  "homepage": "https://gentabase.dev/docs/reference/cli",
  "bugs": "https://github.com/hk8xb/gentabase-cli/issues",
  "license": "MIT",
  "author": "Gentabase",
  "type": "module",
  "engines": {
    "npm": ">=8"
  },
  "files": [
    "scripts"
  ],
  "scripts": {
    "postinstall": "node scripts/postinstall.js"
  },
  "bin": {
    "gentabase": "bin/gentabase"
  },
  "dependencies": {
    "bin-links": "^7.0.0",
    "https-proxy-agent": "^9.0.0",
    "node-fetch": "^3.3.2",
    "tar": "7.5.16"
  },
  "release": {
    "branches": [
      {
        "name": "+([0-9])?(.{+([0-9]),x}).x",
        "channel": "hotfix"
      },
      {
        "name": "develop",
        "channel": "latest"
      }
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/git"
    ]
  }
}
